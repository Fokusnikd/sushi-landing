{
  "title": "Суши для Андрюши",
  "sections": [
    {
      "key": "shop",
      "label": "Контакты",
      "type": "group",
      "hint": "Телефон, часы работы и зона доставки — в шапке и внизу сайта.",
      "fields": [
        {
          "key": "name",
          "label": "Название ресторана",
          "type": "text",
          "required": true,
          "maxLength": 40
        },
        {
          "key": "phone",
          "label": "Телефон",
          "type": "text",
          "required": true,
          "hint": "Как показывать на сайте, например +7 (495) 123-45-67. Ссылка для звонка соберётся сама."
        },
        {
          "key": "hours",
          "label": "Часы работы",
          "type": "text"
        },
        {
          "key": "zone",
          "label": "Зона доставки",
          "type": "text"
        },
        {
          "key": "contactsTitle",
          "label": "Заголовок блока «Контакты»",
          "type": "text",
          "maxLength": 80
        }
      ]
    },
    {
      "key": "hero",
      "label": "Первый экран",
      "type": "group",
      "hint": "То, что посетитель видит сразу при открытии сайта.",
      "fields": [
        {
          "key": "badge",
          "label": "Плашка над заголовком",
          "type": "text",
          "maxLength": 40
        },
        {
          "key": "titleStart",
          "label": "Заголовок: начало",
          "type": "text",
          "maxLength": 30
        },
        {
          "key": "titleAccent",
          "label": "Заголовок: выделенное слово",
          "type": "text",
          "maxLength": 20
        },
        {
          "key": "titleEnd",
          "label": "Заголовок: конец",
          "type": "text",
          "maxLength": 30
        },
        {
          "key": "text",
          "label": "Текст под заголовком",
          "type": "textarea",
          "maxLength": 220
        },
        {
          "key": "primaryButton",
          "label": "Главная кнопка",
          "type": "text",
          "maxLength": 24
